# Network Rail CIF data (directory or single .mca/.cif file)
CIF_DATA_PATH=data/cif

# Network Rail CORPUS extract (JSON)
CORPUS_DATA_PATH=data/corpus/CORPUSExtract.json

# NESA / Rail Data Marketplace mileage data (JSON)
MILEAGE_DATA_PATH=data/mileage/mileage.json

# Darwin OpenLDBWS API
DARWIN_API_URL=https://lite.realtime.nationalrail.co.uk/OpenLDBWS/ldb12.asmx
DARWIN_API_TOKEN=your-darwin-token-here
DARWIN_TIMEOUT_SECONDS=10
DARWIN_MAX_RETRIES=2

# Application settings
MAX_DATE_RANGE_DAYS=31
ALLOWED_OPERATORS=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_SIZE_BYTES=1048576

# Output
OUTPUT_DIR=output

# Logging
LOG_LEVEL=INFO
