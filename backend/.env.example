# ── Data paths ──────────────────────────────────────────────────────────────
# Leave these commented out — the app resolves them automatically relative to
# the backend/data/ directory. Only set them if you want to override the
# location to an absolute path on your machine.
#
# CIF_DATA_PATH=/absolute/path/to/cif
# CORPUS_DATA_PATH=/absolute/path/to/CORPUSExtract.json
# MILEAGE_DATA_PATH=/absolute/path/to/mileage.json

# ── Darwin OpenLDBWS API ─────────────────────────────────────────────────────
# Required for train_class and number_of_coaches columns.
# Register at: https://realtime.nationalrail.co.uk/OpenLDBWSRegistration/
# Leave blank to skip Darwin enrichment (columns will be empty).
DARWIN_API_URL=https://lite.realtime.nationalrail.co.uk/OpenLDBWS/ldb12.asmx
DARWIN_API_TOKEN=

# ── Application settings ─────────────────────────────────────────────────────
MAX_DATE_RANGE_DAYS=31
ALLOWED_OPERATORS=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_SIZE_BYTES=1048576

# ── Output / Logging ─────────────────────────────────────────────────────────
OUTPUT_DIR=output
LOG_LEVEL=INFO
